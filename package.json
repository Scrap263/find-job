{
  "name": "find-job",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm run dev -w @find-job/web\" \"npm run dev -w @find-job/api\"",
    "dev:web": "npm run dev -w @find-job/web",
    "dev:api": "npm run dev -w @find-job/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "10.0.3",
    "next": "16.2.10",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
