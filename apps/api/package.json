    "test": "node --test src/connectors/hh.test.ts"
  },
  "dependencies": {
    "@find-job/domain": "0.1.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "@types/pg": "8.20.0",
    "typescript": "5.9.3"
  }
}
